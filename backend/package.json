{
  "name": "laxa-backend",
  "version": "1.0.0",
  "description": "Laxa Backend - Node.js + Express + PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec node --loader tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node --loader tsx src/database/migrate.ts",
    "seed": "node --loader tsx src/database/seed.ts",
    "test": "vitest",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.0",
    "dotenv": "^16.3.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.0",
    "socket.io": "^4.7.0",
    "axios": "^1.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.0",
    "nodemon": "^3.0.0",
    "tsx": "^3.14.0",
    "eslint": "^8.50.0",
    "vitest": "^0.34.0"
  }
}
